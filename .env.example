# =============================================================================
# Pulso — variáveis de ambiente
# =============================================================================
# O arquivo .env é OPCIONAL: o docker-compose.yml e o scripts/dev-backend.mjs
# já usam estes mesmos valores como padrão. Copie para .env só para mudar algo:
#
#   cp .env.example .env
#
# [SEGREDO] = troque obrigatoriamente fora do ambiente acadêmico. Os valores
# abaixo são públicos (estão neste repositório) e servem apenas para desenvolvimento.
# Senhas usadas em URLs (banco, broker) não devem conter @ : / ? # % (ou devem
# ser codificadas para URL).

# -----------------------------------------------------------------------------
# Imagens base (troque por um espelho se o Docker Hub limitar seus downloads,
# por exemplo mirror.gcr.io/library/node:22-alpine)
# -----------------------------------------------------------------------------
NODE_IMAGE=node:22-alpine
NGINX_IMAGE=nginx:1.27-alpine
POSTGRES_IMAGE=postgres:16-alpine
RABBITMQ_IMAGE=rabbitmq:3.13-management-alpine

# -----------------------------------------------------------------------------
# Portas publicadas no computador (host)
# -----------------------------------------------------------------------------
# Aplicação web (nginx). Aberta na rede local para testes em celular.
FRONTEND_PORT=8080
# As demais só escutam em 127.0.0.1 (seu computador).
GATEWAY_PORT=3000
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# -----------------------------------------------------------------------------
# PostgreSQL (uma instância, um schema e um usuário por serviço)
# -----------------------------------------------------------------------------
# Superusuário, usado apenas na criação do banco e dos schemas.
POSTGRES_USER=pulso
# [SEGREDO]
POSTGRES_PASSWORD=pulso_dev
POSTGRES_DB=pulso

# Senha do usuário <serviço>_app de cada schema. Aplicadas por
# database/init/01-init.sh quando o volume do banco é criado. Depois de mudar,
# reaplique o script sem perder dados (veja "Banco de dados" no README) ou
# recrie o volume com docker compose down -v, o que APAGA os dados.
# [SEGREDO] todas
IDENTITY_DB_PASSWORD=identity_dev_password
SCHEDULING_DB_PASSWORD=scheduling_dev_password
CLINICAL_DB_PASSWORD=clinical_dev_password
INVENTORY_DB_PASSWORD=inventory_dev_password
ENGAGEMENT_DB_PASSWORD=engagement_dev_password
NOTIFICATION_DB_PASSWORD=notification_dev_password

# Banco de sombra (shadow database) do "prisma migrate dev": pulso_shadow, criado
# pelo mesmo script, com um schema por serviço. Não é uma variável deste arquivo:
# o scripts/dev-backend.mjs monta SHADOW_DATABASE_URL de cada serviço, e quem roda
# o Prisma à mão usa o padrão abaixo (mesmo usuário e senha do DATABASE_URL).
#   SHADOW_DATABASE_URL=postgresql://<serviço>_app:<senha>@localhost:5432/pulso_shadow?schema=<serviço>

# -----------------------------------------------------------------------------
# RabbitMQ (exchange de eventos pulso.events)
# -----------------------------------------------------------------------------
RABBITMQ_USER=pulso
# [SEGREDO]
RABBITMQ_PASSWORD=pulso_dev

# -----------------------------------------------------------------------------
# Back-end (gateway e serviços)
# -----------------------------------------------------------------------------
# Token das rotas /internal/* entre serviços (mínimo de 16 caracteres).
# Gere um novo com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# [SEGREDO]
INTERNAL_API_TOKEN=pulso-dev-internal-token-troque-em-producao

# Nível dos logs (JSON): fatal, error, warn, info, debug ou trace.
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Gateway
# -----------------------------------------------------------------------------
# Origens autorizadas a chamar a API pelo navegador (CORS), separadas por vírgula.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# Rate limit em memória: janela em milissegundos, máximo geral e máximo nas rotas de autenticação.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# -----------------------------------------------------------------------------
# Desenvolvimento local (scripts/dev-backend.mjs)
# -----------------------------------------------------------------------------
# "true" formata os logs para leitura humana (pino-pretty, só em desenvolvimento).
LOG_PRETTY=true
