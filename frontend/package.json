{
  "name": "@pulso/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Frontend React do Pulso (doador, equipe e administração)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "dev:demo": "vite --mode demo --open /demo.html",
    "build:demo": "tsc -p tsconfig.demo.json --noEmit && vite build --mode demo"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@hookform/resolvers": "^5.2.1",
    "@noble/hashes": "^1.8.0",
    "@tanstack/react-query": "^5.85.0",
    "clsx": "^2.1.1",
    "jspdf": "^3.0.4",
    "lucide-react": "^0.540.0",
    "luxon": "^3.7.2",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "react-router-dom": "^7.8.0",
    "recharts": "^2.15.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@types/luxon": "^3.7.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.3",
    "vite": "^7.1.2",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
